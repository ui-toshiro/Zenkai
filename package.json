{
  "name": "zenkai-platform",
  "version": "2.0.0",
  "description": "ZENKAI - Modern Movies & Music Events Discovery Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/src/server.js",
    "dev:server": "node server/src/server.js",
    "dev:client": "npm run dev --prefix client",
    "seed": "node server/src/data/seed_all_cloud.js"
  },
  "keywords": [
    "zenkai",
    "movies",
    "cinema-showtimes",
    "music-festivals",
    "concerts",
    "ticket-pricing",
    "express",
    "react",
    "vite"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
